{
  "datasets": [
    {
      "name": "ds_matriz_diaria",
      "displayName": "V1 - Matriz de trafico diaria (oro)",
      "queryLines": [
        "SELECT celda_lat, celda_lon, intensidad, buques\n",
        "FROM clase14.equipo9.oceanwatch_gold_matriz_trafico_diaria\n",
        "WHERE dia = coalesce(try_cast(:fecha AS DATE), (SELECT max(dia) FROM clase14.equipo9.oceanwatch_gold_trayectorias_diarias))\n",
        "ORDER BY intensidad DESC, celda_lat, celda_lon\n",
        "LIMIT 2000"
      ],
      "parameters": [
        {
          "displayName": "Fecha UTC",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Última fecha"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_ranking_puertos",
      "displayName": "V2 - Ranking de puertos (oro)",
      "queryLines": [
        "SELECT INDEX_NO, PORT_NAME, COUNTRY,\n",
        "       COUNT(DISTINCT MMSI)        AS buques_distintos,\n",
        "       SUM(n_posiciones_en_puerto) AS posiciones_ais\n",
        "FROM clase14.equipo9.oceanwatch_gold_presencia_puertos\n",
        "WHERE dia = coalesce(try_cast(:fecha AS DATE), (SELECT max(dia) FROM clase14.equipo9.oceanwatch_gold_trayectorias_diarias))\n",
        "GROUP BY INDEX_NO, PORT_NAME, COUNTRY\n",
        "ORDER BY buques_distintos DESC, INDEX_NO\n",
        "LIMIT 15"
      ],
      "parameters": [
        {
          "displayName": "Fecha UTC",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Última fecha"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_buques_puerto",
      "displayName": "V3 - Buques en puerto (oro)",
      "queryLines": [
        "SELECT MMSI, PORT_NAME, COUNTRY,\n",
        "       n_posiciones_en_puerto,\n",
        "       primera_posicion, ultima_posicion\n",
        "FROM clase14.equipo9.oceanwatch_gold_presencia_puertos\n",
        "WHERE dia = coalesce(try_cast(:fecha AS DATE), (SELECT max(dia) FROM clase14.equipo9.oceanwatch_gold_trayectorias_diarias))\n",
        "ORDER BY n_posiciones_en_puerto DESC, MMSI, INDEX_NO\n",
        "LIMIT 500"
      ],
      "parameters": [
        {
          "displayName": "Fecha UTC",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Última fecha"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_anomalias",
      "displayName": "V4 - Anomalias del dia (oro)",
      "queryLines": [
        "SELECT MMSI, BaseDateTime, LAT, LON, SOG, VesselType,\n",
        "       z_sog, score_anomalia, razon\n",
        "FROM clase14.equipo9.oceanwatch_gold_anomalias_velocidad\n",
        "WHERE _batch_date = coalesce(try_cast(:fecha AS DATE), (SELECT max(dia) FROM clase14.equipo9.oceanwatch_gold_trayectorias_diarias)) AND es_anomalia = true\n",
        "ORDER BY score_anomalia ASC, MMSI, BaseDateTime\n",
        "LIMIT 500"
      ],
      "parameters": [
        {
          "displayName": "Fecha UTC",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Última fecha"
                }
              ]
            }
          }
        }
      ]
    }
  ],
